{
  "name": "cars-data",
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "predev": "node check-packages.js",
    "dev": "vite --config ./vite.config.ts --open",
    "dev:check": "vite --config ./vite.config.ts --open -- --use-checker",
    "preview": "vite preview --config ./vite.config.ts",
    "http": "http-server ../data/misc --cors -p 8000",
    "playwright:setup": "playwright install --with-deps",
    "playwright": "playwright test --config=playwright.config.ts",
    "playwright:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "cypress:setup": "concurrently -k \"pnpm run preview\" \"pnpm run http\"",
    "cypress": "start-server-and-test 'pnpm run cypress:setup' \"http://localhost:3000|http://localhost:8000\" 'cypress run'",
    "vitest": "vitest --config vitest.config.ts",
    "audit": "pnpm audit --audit-level high --prod",
    "eslint": "eslint . --config ./eslint.config.js --cache",
    "eslint:fix": "eslint . --config ./eslint.config.js --fix",
    "lint": "biome lint --diagnostic-level=warn .",
    "lint:fix": "biome lint --diagnostic-level=warn --write .",
    "format": "biome format --diagnostic-level=warn .",
    "format:fix": "biome format --diagnostic-level=warn --write .",
    "typecheck": "tsc -p ./tsconfig.json",
    "build": "vite --config ./vite.config.ts build",
    "prepare": "cd .. && husky app/.husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "chart.js": "^4.6.1",
    "chartjs-chart-treemap": "^4.2.2",
    "i18next": "^26.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.3",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.5"
  }
}
